{
  "$schema": "https://schemas.nimblebrain.ai/v1/nimblebrain-server.schema.json",
  "name": "ai.nimblebrain/synapse-todo-board",
  "description": "Kanban and table views for boards and tasks, with agent tools",
  "version": "0.3.1",
  "title": "Todo Board Synapse App",
  "repository": {
    "url": "https://github.com/NimbleBrainInc/synapse-todo-board",
