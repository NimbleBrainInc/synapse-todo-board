{
  "manifest_version": "0.4",
  "name": "@nimblebraininc/synapse-todo-board",
  "display_name": "Synapse Todo Board",
  "version": "0.3.2",
  "description": "Kanban and table views for boards and tasks, with agent tools",
  "author": {
    "name": "NimbleBrain Inc."
  },
  "icon": "https://static.nimblebrain.ai/icons/todo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimbleBrainInc/synapse-todo-board"
  },
  "server": {
    "type": "python",
    "entry_point": "synapse_todo_board.server",
    "mcp_config": {
      "command": "python",
      "args": [
        "-m",
        "synapse_todo_board.server"
      ]
    }
  },
  "_meta": {
    "org.mpaktrust": {
      "mtf_version": "0.1",
      "permissions": {
        "filesystem": "write",
        "network": "none",
        "environment": "read",
        "subprocess": "none",
        "native": "none"
      }
    },
    "ai.nimblebrain/host": {
      "host_version": "1.0",
      "name": "Todo Board",
      "icon": "list-checks",
      "category": "operations",
      "placements": [
        {
          "slot": "sidebar.apps",
          "resourceUri": "ui://todo-board/main",
          "route": "@nimblebraininc/synapse-todo-board",
          "label": "Todo Board",
          "icon": "list-checks"
        },
        {
          "slot": "settings",
          "resourceUri": "ui://todo-board/settings",
          "label": "Todo Board",
          "icon": "list-checks",
          "priority": 100
        }
      ],
      "briefing": {
        "priority": "medium",
        "facets": [
          {
            "name": "completed_tasks",
            "label": "Completed",
            "type": "activity",
            "entity": "task",
            "query": {
              "completed_at": {
                "$gte": "${period.since}"
              }
            },
            "metric": "count",
            "description": "Tasks completed in this period"
          },
          {
            "name": "blocked_tasks",
            "label": "Blocked",
            "type": "attention",
            "entity": "task",
            "query": {
              "column": "blocked",
              "status": "active"
            },
            "metric": "count",
            "description": "Tasks stuck in blocked column"
          },
          {
            "name": "due_today",
            "label": "Due today",
            "type": "upcoming",
            "entity": "task",
            "query": {
              "due_date": "${today}",
              "completed_at": null
            },
            "metric": "count",
            "description": "Tasks due today that aren't done"
          },
          {
            "name": "overdue_tasks",
            "label": "Overdue",
            "type": "attention",
            "entity": "task",
            "query": {
              "due_date": {
                "$lt": "${today}"
              },
              "completed_at": null
            },
            "metric": "count",
            "description": "Tasks past their due date that aren't done"
          }
        ]
      }
    }
  }
}
